{
  "name": "suarex-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck && pnpm typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/write-test-env.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts",
    "seed:staff": "node scripts/seed-staff.mjs",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@playwright/test": "^1.61.1",
    "@suarex/agent": "workspace:*",
    "@suarex/config": "workspace:*",
    "@suarex/db": "workspace:*",
    "@suarex/payments": "workspace:*",
    "@suarex/printing": "workspace:*",
    "@suarex/realtime": "workspace:*",
    "@suarex/ticket": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "lint-staged": "^16.4.0",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "stripe": "^22.3.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
